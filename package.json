{
	"name": "custom-slowmode",
	"author": "CTNOriginals",
	"version": "2.0.0",
	"description": "A discord bot that allows you to set a custom slowmode on any channel with some extra useful options that discord doesn't provide",
	"license": "BSD-4-Clause",
	"main": "dist/index.js",
	"homepage": "https://github.com/CTN-Originals/Custom SlowMode",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"build": "tsc",
		"fullbuild": "rimraf ./dist && npm run build",
		"build:start": "npm run build && npm run start",
		"dev:deploy": "npm run build && node ./dist/index.js --deploy --guild=DEV_GUILD_ID deployAll=true",
		"dev:dry-deploy": "npm run build && node ./dist/index.js --deploy --dry-run --guild=DEV_GUILD_ID deployAll=true",
		"deploy": "node ./dist/index.js --deploy --deployAllGlobal=true",
		"lint": "eslint -c eslint.config.mjs src/",
		"lint:fix": "eslint -c eslint.config.mjs src/ --fix",
		"test": "tsx watch tests/index.ts"
	},
	"dependencies": {
		"axios": "^1.8.2",
		"better-console-utilities": "^1.1.1",
		"discord.js": "^14.18.0",
		"dotenv": "^16.4.7",
		"moment": "^2.30.1",
		"mongoose": "^8.12.1"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.7",
		"@eslint/eslintrc": "^3.3.0",
		"@types/mongoose": "^5.11.97",
		"@types/node": "^22.13.10",
		"@typescript-eslint/eslint-plugin": "^8.26.1",
		"@typescript-eslint/parser": "^8.26.1",
		"eslint": "^9.22.0",
		"eslint-plugin-import": "^2.31.0",
		"nodemon": "^3.1.9",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1"
	},
	"packageManager": "yarn@4.6.0"
}
